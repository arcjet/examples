# Get your Arcjet key from https://app.arcjet.com
ARCJET_KEY=
# Get your AI Gateway key from https://vercel.com/docs/ai-gateway. Used to
# call the model that powers the support agent.
AI_GATEWAY_API_KEY=
# Optional: a direct OpenAI key if you are not using the AI Gateway.
# OPENAI_API_KEY=
# Optional: override the model id (defaults to gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini
# Optional: override the listen port (defaults to 3000).
# PORT=3000
# Optional: Arcjet SDK log verbosity (debug, info, warn, error).
# ARCJET_LOG_LEVEL=debug
