{
  "dependencies": {
    "@arcjet/astro": "1.10.0",
    "@astrojs/node": "11.1.2",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3"
  },
  "name": "@arcjet-examples/astro",
  "overrides": {
    "yaml": ">=2.8.3"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-astro"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  },
  "repository": "github:arcjet/example-astro",
  "scripts": {
    "build": "astro build",
    "check": "astro check",
    "dev": "astro dev --host",
    "start": "astro preview --host"
  },
  "type": "module",
  "version": "0.0.0"
}
