# Get your Arcjet key from https://app.arcjet.com
ARCJET_KEY=
# Get your AI Gateway key from https://vercel.com/docs/ai-gateway. Used by
# Strands OpenAIModel to call the model that powers the support agent.
AI_GATEWAY_API_KEY=
# Optional: use a direct OpenAI key instead of AI Gateway.
# OPENAI_API_KEY=
# Optional: override the listen port (defaults to 3000).
# PORT=3000
# Optional: Arcjet SDK log verbosity (debug, info, warn, error).
# ARCJET_LOG_LEVEL=debug
# Optional: override the model id (defaults to gpt-4o-mini).
# STRANDS_MODEL=gpt-4o-mini
