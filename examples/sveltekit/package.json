{
  "dependencies": {
    "@arcjet/inspect": "^1.16.0",
    "@arcjet/sveltekit": "^1.16.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.4",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "name": "@arcjet-example/sveltekit",
  "prettier": {
    "plugins": [
      "prettier-plugin-svelte"
    ],
    "overrides": [
      {
        "files": "*.svelte",
        "options": {
          "parser": "svelte"
        }
      }
    ]
  },
  "repository": "github:arcjet/example-sveltekit",
  "scripts": {
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dev": "vite dev --host",
    "prepare": "svelte-kit sync || echo ''",
    "start": "vite preview --host"
  },
  "type": "module",
  "version": "0.0.0",
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
